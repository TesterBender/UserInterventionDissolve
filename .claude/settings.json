{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/check-comments.mjs --hook",
            "timeout": 20,
            "statusMessage": "Checking comment pointers"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "permissions": {
    "allow": [
      "Bash(node tools/*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx eslint*)"
    ]
  }
}
